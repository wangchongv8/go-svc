syntax = "v1"

info (
	title:   "gateway-api"
	desc:    "Gateway API for e-commerce system"
	author:  "go-svc"
	version: "v1"
)

// ---------- auth types (Phase 9: Kratos) ----------
type (
	AuthRegisterReq {
		Username string `json:"username"`
		Password string `json:"password"`
	}
	AuthRegisterResp {
		SessionToken string `json:"session_token,omitempty"`
		UserID       int64  `json:"user_id"`
		Username     string `json:"username"`
	}
	AuthLoginReq {
		Username string `json:"username"`
		Password string `json:"password"`
	}
	AuthLoginResp {
		SessionToken string `json:"session_token,omitempty"`
		UserID       int64  `json:"user_id"`
		Username     string `json:"username"`
	}
	AuthMeResp {
		UserID   int64  `json:"user_id"`
		Username string `json:"username"`
	}
)

// ---------- user types ----------
type (
	GetUserReq {
		ID int64 `path:"id"`
	}
	GetUserResp {
		ID       int64  `json:"id"`
		Username string `json:"username"`
	}
	HealthzResp {
		Status string `json:"status"`
	}
)

// ---------- product types ----------
type (
	CreateProductReq {
		Name        string `json:"name"`
		Description string `json:"description,optional"`
		PriceCents  int64  `json:"price_cents"`
	}
	ProductResp {
		ID          int64  `json:"id"`
		Name        string `json:"name"`
		Description string `json:"description"`
		PriceCents  int64  `json:"price_cents"`
		Status      string `json:"status"`
	}
	ListProductsResp {
		Products []ProductResp `json:"products"`
	}
	SetProductStatusReq {
		ID     int64  `path:"id"`
		Status string `json:"status"`
	}
	GetProductReq {
		ID int64 `path:"id"`
	}
)

// ---------- inventory types ----------
type (
	SetStockReq {
		ProductID int64 `path:"product_id"`
		Stock     int64 `json:"stock"`
	}
	GetStockReq {
		ProductID int64 `path:"product_id"`
	}
	StockResp {
		ProductID int64 `json:"product_id"`
		Stock     int64 `json:"stock"`
	}
)

// ---------- order types ----------
type (
	CreateOrderReq {
		ProductID int64 `json:"product_id"`
		Quantity  int64 `json:"quantity"`
	}
	GetOrderReq {
		ID int64 `path:"id"`
	}
	ListUserOrdersReq {
		UserID int64 `path:"user_id"`
	}
	OrderResp {
		ID              int64  `json:"id"`
		UserID          int64  `json:"user_id"`
		ProductID       int64  `json:"product_id"`
		Quantity        int64  `json:"quantity"`
		UnitPriceCents  int64  `json:"unit_price_cents"`
		TotalPriceCents int64  `json:"total_price_cents"`
		Status          string `json:"status"`
		CreatedAt       int64  `json:"created_at"`
	}
	ListUserOrdersResp {
		Orders []OrderResp `json:"orders"`
	}
)

// ---------- service blocks ----------
// Auth public — register and login.
@server (
	prefix: /api/v1
	group:  auth
)
service gateway-api {
	@handler authRegister
	post /auth/register (AuthRegisterReq) returns (AuthRegisterResp)

	@handler authLogin
	post /auth/login (AuthLoginReq) returns (AuthLoginResp)
}

// Auth protected — current user profile (reads from middleware context).
@server (
	prefix:     /api/v1
	group:      auth
	middleware: AuthMiddleware
)
service gateway-api {
	@handler authMe
	get /auth/me returns (AuthMeResp)
}

@server (
	prefix: /api/v1
	group:  user
)
service gateway-api {
	@handler getUser
	get /users/:id (GetUserReq) returns (GetUserResp)
}

// Product write operations — require auth.
@server (
	prefix:     /api/v1
	group:      product
	middleware: AuthMiddleware
)
service gateway-api {
	@handler createProduct
	post /products (CreateProductReq) returns (ProductResp)

	@handler setProductStatus
	patch /products/:id/status (SetProductStatusReq) returns (ProductResp)
}

// Product read operations — public.
@server (
	prefix: /api/v1
	group:  product
)
service gateway-api {
	@handler listProducts
	get /products returns (ListProductsResp)

	@handler getProduct
	get /products/:id (GetProductReq) returns (ProductResp)
}

// Inventory write operations — require auth.
@server (
	prefix:     /api/v1
	group:      inventory
	middleware: AuthMiddleware
)
service gateway-api {
	@handler setStock
	put /inventories/:product_id (SetStockReq) returns (StockResp)
}

// Inventory read operations — public.
@server (
	prefix: /api/v1
	group:  inventory
)
service gateway-api {
	@handler getStock
	get /inventories/:product_id (GetStockReq) returns (StockResp)
}

@server (
	prefix:     /api/v1
	group:      order
	middleware: AuthMiddleware
)
service gateway-api {
	@handler createOrder
	post /orders (CreateOrderReq) returns (OrderResp)

	@handler getOrder
	get /orders/:id (GetOrderReq) returns (OrderResp)

	@handler listUserOrders
	get /users/:user_id/orders (ListUserOrdersReq) returns (ListUserOrdersResp)
}

@server (
	group: health
)
service gateway-api {
	@handler healthz
	get /healthz
}

